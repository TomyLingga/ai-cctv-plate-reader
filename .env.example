# Copy to .env and fill in. Never commit .env.
# Camera credentials stay here, not in config/app.yaml and not in code.
# config/app.yaml refers to these variables by name (url_env).

ALPR_CAM_1_URL=rtsp://USER:PASSWORD@192.168.1.205:554/Streaming/Channels/101
ALPR_CAM_2_URL=rtsp://USER:PASSWORD@192.168.1.201:554/Streaming/Channels/101
ALPR_CAM_3_URL=rtsp://USER:PASSWORD@192.168.1.206:554/Streaming/Channels/101
ALPR_CAM_4_URL=rtsp://USER:PASSWORD@192.168.1.200:554/Streaming/Channels/101

# API server
ALPR_HOST=0.0.0.0
ALPR_PORT=5000

ALPR_CONFIG=config/app.yaml

# Token for adding, changing and removing cameras from the browser page /ui/cameras.
# At least 8 characters; use a long random value. Without it those actions are refused,
# while the monitoring page and the read-only API keep working.
ALPR_ADMIN_TOKEN=

# ONNX Runtime build used by start-alpr.bat and install-autostart.ps1: cpu or gpu
ALPR_EXTRA=cpu
